# ---------------------------------------------------------------------------
# PUBLIC-REPO GUARD
# This repository is PUBLIC on GitHub (checked 25-Sep-2026). Lead data holds
# owner names and mobile numbers, which CLAUDE.md Section 8 restricts to
# Giraffe's own one-to-one outreach. Keep it out of git until the repo is
# made private. Once it is private, delete this block so the database and
# outputs persist between cloud sessions.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/work/
output/*
!output/.gitkeep
input/*
!input/.gitkeep
# ---------------------------------------------------------------------------

__pycache__/
*.pyc
.pytest_cache/
tests/_tmp/

# ROOT website build (root-website/): the confidential fact base and the original theme artifact stay
# out of git (repo is public); screenshots are large and regenerated by scripts/shoot.py.
root-website/private/
root-website/review/**/*.png
root-website/review/.locks/
root-website/review/.tmp-*/
root-website/packs/
